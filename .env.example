# AWS API Gateway
AWS_API_BASE_URL=https://your-api-gateway-url.execute-api.us-west-2.amazonaws.com

# Cognito
COGNITO_DOMAIN=https://your-pool.auth.us-west-2.amazoncognito.com
COGNITO_CLIENT_ID=your-cognito-app-client-id
COGNITO_REDIRECT_URI=http://localhost:3000/api/auth/callback
COGNITO_LOGOUT_URI=http://localhost:3000

# Session encryption (iron-session) — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-me-generate-with-node-e-require-crypto-randomBytes-32-toString-hex
