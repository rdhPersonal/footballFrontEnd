# BFF Route Handlers

The `src/app/api/` directory contains Next.js Route Handlers that serve as a thin **Backend for Frontend** (BFF) layer between the React UI and the AWS backend APIs.

## Principles

1. **Thin proxy.** The BFF forwards requests to AWS APIs. It does NOT contain business logic — that belongs in the AWS backend codebase.
2. **Server-side secrets.** AWS API keys, Cognito client credentials, and auth tokens live in environment variables and NEVER ship to the browser.
3. **Aggregation.** When a page needs data from multiple AWS endpoints, the BFF can combine them into a single response to reduce client round-trips.
4. **Auth gating.** Every non-auth BFF route validates the user's session cookie before proxying to AWS. Unauthenticated requests return 401.

## Auth Route Handlers

### `/api/auth/login` — Initiate Sign-In

```typescript
// src/app/api/auth/login/route.ts
import { NextRequest, NextResponse } from 'next/server';
import crypto from 'crypto';

export async function GET(request: NextRequest): Promise<NextResponse> {
  // 1. Generate PKCE code verifier and challenge
  const codeVerifier = crypto.randomBytes(32).toString('base64url');
  const codeChallenge = crypto
    .createHash('sha256')
    .update(codeVerifier)
    .digest('base64url');

  // 2. Store code verifier in a temporary cookie (needed for callback)
  const response = NextResponse.redirect(buildCognitoAuthUrl(codeChallenge));
  response.cookies.set('pkce_verifier', codeVerifier, {
    httpOnly: true,
    secure: true,
    sameSite: 'lax', // lax needed for redirect flow
    maxAge: 300, // 5 min TTL
    path: '/',
  });

  return response;
}

function buildCognitoAuthUrl(codeChallenge: string): string {
  const params = new URLSearchParams({
    response_type: 'code',
    client_id: process.env.COGNITO_CLIENT_ID!,
    redirect_uri: process.env.COGNITO_REDIRECT_URI!,
    scope: 'openid profile email',
    code_challenge_method: 'S256',
    code_challenge: codeChallenge,
  });
  return `${process.env.COGNITO_DOMAIN}/oauth2/authorize?${params}`;
}
```

### `/api/auth/callback` — Exchange Code for Tokens

```typescript
// src/app/api/auth/callback/route.ts
import { NextRequest, NextResponse } from 'next/server';

export async function GET(request: NextRequest): Promise<NextResponse> {
  const code = request.nextUrl.searchParams.get('code');
  const codeVerifier = request.cookies.get('pkce_verifier')?.value;

  if (!code || !codeVerifier) {
    return NextResponse.redirect(new URL('/api/auth/login', request.url));
  }

  // 1. Exchange authorization code for tokens (SERVER-SIDE)
  const tokenResponse = await fetch(`${process.env.COGNITO_DOMAIN}/oauth2/token`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
    body: new URLSearchParams({
      grant_type: 'authorization_code',
      client_id: process.env.COGNITO_CLIENT_ID!,
      redirect_uri: process.env.COGNITO_REDIRECT_URI!,
      code,
      code_verifier: codeVerifier,
    }),
  });

  if (!tokenResponse.ok) {
    return NextResponse.redirect(new URL('/api/auth/login', request.url));
  }

  const tokens = await tokenResponse.json();

  // 2. Encrypt tokens into session cookie (using iron-session or similar)
  const response = NextResponse.redirect(new URL('/', request.url));
  // TODO: Use iron-session to seal tokens into encrypted cookie
  // await setSession(response, { accessToken, idToken, refreshToken });

  // 3. Clear PKCE verifier cookie
  response.cookies.delete('pkce_verifier');

  return response;
}
```

### `/api/auth/logout` — End Session

```typescript
// src/app/api/auth/logout/route.ts
import { NextRequest, NextResponse } from 'next/server';

export async function GET(request: NextRequest): Promise<NextResponse> {
  const logoutUrl = new URL(`${process.env.COGNITO_DOMAIN}/logout`);
  logoutUrl.searchParams.set('client_id', process.env.COGNITO_CLIENT_ID!);
  logoutUrl.searchParams.set('logout_uri', process.env.COGNITO_LOGOUT_URI!);

  const response = NextResponse.redirect(logoutUrl);
  // TODO: Clear session cookie
  // await clearSession(response);
  return response;
}
```

